# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=showup

# API server
PORT=3001

# Secret used to sign login tokens (JWT). Use a long random string, e.g. the
# output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
