# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# --- MySQL -------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=showup

# --- API server ----------------------------------------------------------------
PORT=3001
# Public URL of the web app; used for password-reset and ticket links in emails.
# Dev (Vite): http://localhost:5173    Production: your real domain.
APP_URL=http://localhost:5173
# Set to "true" when running behind a reverse proxy / load balancer.
# TRUST_PROXY=true
# NODE_ENV=production

# --- Notifications (optional — each channel is a no-op until configured) --------
# Email (Resend). Also used for password-reset emails. Without it, the reset
# link is printed to the server console in development.
RESEND_API_KEY=
RESEND_FROM=ShowUp <onboarding@resend.dev>

# SMS — India: 2Factor or Fast2SMS. International: Twilio.
TWOFACTOR_API_KEY=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# WhatsApp (Twilio)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
